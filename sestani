<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tape Yaz</title>
<style>
:root{--bg:#e2e8f0;--card:#f8fafc;--text:#0f172a;--muted:#475569;--bd:rgba(0,0,0,.16);--pri:#3b82f6;--ok:#10b981;--c0:#0369a1;--c1:#be123c;--c2:#a16207;--c3:#7e22ce}
*{box-sizing:border-box;margin:0;padding:0;font-family:'Segoe UI',Tahoma,Verdana,sans-serif}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{background:var(--bg);color:var(--text);min-height:100dvh;display:flex;flex-direction:column}
header{background:var(--card);border-bottom:1px solid var(--bd);padding:8px 16px;display:flex;justify-content:space-between;align-items:center;gap:8px}
.logo{font-size:1.15rem;font-weight:700;color:var(--pri)}
.row{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.btn{background:var(--bd);color:var(--text);border:0;padding:6px 10px;border-radius:6px;cursor:pointer;font-size:.8rem}
.btn:hover{opacity:.85}.btn.p{background:var(--pri);color:#fff}
.btn:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--pri);outline-offset:1px}
main{flex:1;display:flex;flex-direction:column;gap:10px;padding:12px;max-width:1400px;width:100%;margin:0 auto}
.card{background:var(--card);border:1px solid var(--bd);border-radius:10px;padding:10px;display:flex;flex-direction:column;gap:8px}
.drop{flex:1;min-width:200px;border:1px dashed var(--bd);padding:8px;border-radius:6px;text-align:center;color:var(--muted);cursor:pointer;position:relative;font-size:.85rem}
.drop input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%}
#vidBox{display:none;width:220px;max-height:130px;background:#000;border-radius:6px;overflow:hidden;resize:both}
#pv{width:100%;height:100%;object-fit:contain}
.seek{display:flex;gap:8px;align-items:center;font-size:.8rem;color:var(--muted)}
.seek input{flex:1;accent-color:var(--pri)}
.sps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
@media(max-width:800px){.sps{grid-template-columns:repeat(2,minmax(0,1fr))}}
.sp{min-width:0;background:var(--card);border:1px solid var(--bd);border-radius:6px;padding:6px 8px;display:flex;align-items:center;gap:6px;border-left:3px solid}
.sp label{font-size:.75rem;font-weight:700;white-space:nowrap}
.sp input[type=text]{flex:1;min-width:0;background:var(--bg);border:1px solid var(--bd);color:var(--text);padding:4px 6px;border-radius:4px;font-size:.85rem}
.sp input[type=color]{border:0;width:22px;height:22px;background:none;cursor:pointer}
.editor{flex:1;min-height:420px;resize:vertical;overflow:hidden;padding:0}
.eh{padding:8px 12px;border-bottom:1px solid var(--bd);display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;font-size:.85rem;color:var(--muted)}
.ew{position:relative;flex:1;min-height:340px;background:var(--bg);border-radius:0 0 10px 10px}
.ed{position:absolute;inset:0;width:100%;height:100%;padding:14px;margin:0;border:0;font-family:ui-monospace,Menlo,Consolas,'Liberation Mono','Courier New',monospace;font-size:16px;line-height:1.6;letter-spacing:0;font-variant-ligatures:none;-webkit-text-size-adjust:100%;white-space:pre-wrap;overflow-wrap:break-word;tab-size:4;scrollbar-gutter:stable}
#bd{display:none;color:var(--text);overflow-y:auto}
.ew.pv #bd{display:block}.ew.pv #ta{display:none}
#ta{background:transparent;color:var(--text);caret-color:var(--text);resize:none;outline:0;overflow-y:auto}
#ta::placeholder{color:var(--muted);opacity:1}